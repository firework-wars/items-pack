{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "firework_bayonet",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:charge_type",
          "cases": [
            {
              "when": "arrow",
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/bayonet_arrow"
              }
            },
            {
              "when": "rocket",
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/bayonet_firework"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_true": {
              "type": "minecraft:range_dispatch",
              "property": "minecraft:crossbow/pull",
              "entries": [
                {
                  "threshold": 0.58,
                  "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/bayonet_pulling_1"
                  }
                },
                {
                  "threshold": 1.0,
                  "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/bayonet_pulling_2"
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:model",
                "model": "minecraft:item/bayonet_pulling_0"
              }
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "minecraft:item/bayonet"
            }
          }
        }
      },
      {
        "when": "firework_shotgun",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:charge_type",
          "cases": [
            {
              "when": "rocket",
              "model": {
                "type": "minecraft:composite",
                "models": [
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/crossbow/shotgun_projectile"
                  },
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/crossbow/shotgun_firework"
                  },
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/crossbow/shotgun_hammer_projectile"
                  }
                ]
              }
            }
          ],
          "fallback": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_true": {
              "type": "minecraft:range_dispatch",
              "property": "minecraft:crossbow/pull",
              "entries": [
                {
                  "threshold": 0.58,
                  "model": {
                    "type": "minecraft:composite",
                    "models": [
                      {
                        "type": "minecraft:model",
                        "model": "minecraft:item/crossbow/shotgun_pulling"
                      },
                      {
                        "type": "minecraft:model",
                        "model": "minecraft:item/crossbow/shotgun_hammer_pulling_1"
                      }
                    ]
                  }
                },
                {
                  "threshold": 1.0,
                  "model": {
                    "type": "minecraft:composite",
                    "models": [
                      {
                        "type": "minecraft:model",
                        "model": "minecraft:item/crossbow/shotgun_pulling"
                      },
                      {
                        "type": "minecraft:model",
                        "model": "minecraft:item/crossbow/shotgun_hammer_pulling_0"
                      }
                    ]
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:composite",
                "models": [
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/crossbow/shotgun_pulling"
                  },
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/crossbow/shotgun_hammer_pulling_0"
                  }
                ]
              }
            },
            "on_false": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow/shotgun"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow/shotgun_hammer"
                }
              ]
            }
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_arrow"
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_firework"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_true": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:crossbow/pull",
          "entries": [
            {
              "threshold": 0.58,
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow_pulling_1"
              }
            },
            {
              "threshold": 1.0,
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow_pulling_2"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_pulling_0"
          }
        },
        "on_false": {
          "type": "minecraft:model",
          "model": "minecraft:item/crossbow"
        }
      }
    }
  }
}