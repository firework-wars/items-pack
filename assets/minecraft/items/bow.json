{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "rocket_launcher",
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:display_context",
          "cases": [
            {
              "when": "gui",
              "model": {
                "type": "minecraft:model",
                "model": "fww:item/icon/rocket_launcher"
              }
            },
            {
              "when": "ground",
              "model": {
                "type": "minecraft:model",
                "model": "fww:item/icon/rocket_launcher_ground"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_true": {
              "type": "minecraft:range_dispatch",
              "property": "minecraft:use_duration",
              "scale": 0.05,
              "entries": [
                {
                  "threshold": 0.95,
                  "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/crossbow/air_strike_pulling"
                  }
                },
                {
                  "threshold": 1.95,
                  "model": {
                    "type": "minecraft:model",
                    "model": "minecraft:item/crossbow/air_strike"
                  }
                },
                {
                  "threshold": 2.8,
                  "model": {
                    "type": "minecraft:composite",
                    "models": [
                      {
                        "type": "minecraft:model",
                        "model": "minecraft:item/crossbow/air_strike_projectile_bow"
                      },
                      {
                        "type": "minecraft:model",
                        "model": "minecraft:item/crossbow/air_strike_firework_bow"
                      }
                    ]
                  }
                }
              ],
              "fallback": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow/air_strike"
              }
            },
            "on_false": {
              "type": "minecraft:model",
              "model": "minecraft:item/crossbow/air_strike"
            }
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:use_duration",
        "scale": 0.05,
        "entries": [
          {
            "threshold": 0.65,
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_1"
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "type": "minecraft:model",
              "model": "minecraft:item/bow_pulling_2"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "minecraft:item/bow_pulling_0"
        }
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "minecraft:item/bow"
      }
    }
  },
  "oversized_in_gui": true
}